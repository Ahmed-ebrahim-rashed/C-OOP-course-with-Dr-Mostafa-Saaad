// ============================================
// Day 6: 1D Arrays + Char Arrays
// ============================================

#include <iostream>
#include <string>
using namespace std;

int main()
{
    // ==========================================
    // 1. 1D ARRAYS — BASICS
    // ==========================================
    cout << "========== 1. 1D Arrays ==========\n";

    const int size = 5;
    int numbers[size] = { 10, 2, 7, 5, 3 };

    numbers[0] = 9;
    numbers[2] *= 3;
    numbers[4]++;

    cout << "Array: ";
    for (int i = 0; i < size; ++i)
        cout << numbers[i] << " ";
    cout << "\n";

    // Reverse
    cout << "Reverse: ";
    for (int i = 0; i < size; ++i)
        cout << numbers[size - i - 1] << " ";
    cout << "\n";


    // ==========================================
    // 2. 1D ARRAYS — MIN
    // ==========================================
    cout << "\n========== 2. Min of Array ==========\n";

    int arr2[5];
    cout << "Enter 5 numbers: ";
    for (int i = 0; i < 5; ++i)
        cin >> arr2[i];

    int minimum = arr2[0];
    for (int i = 1; i < 5; ++i)
        if (minimum > arr2[i])
            minimum = arr2[i];
    cout << "Minimum = " << minimum << "\n";


    // ==========================================
    // 3. MAX + 2ND MAX
    // ==========================================
    cout << "\n========== 3. Max + 2nd Max ==========\n";

    int n = 5;
    int nums[200] = { 10, 20, 3, 30, 7 };

    int max1, max2;
    if (nums[0] >= nums[1])
        max1 = nums[0], max2 = nums[1];
    else
        max1 = nums[1], max2 = nums[0];

    for (int i = 2; i < n; ++i)
        if (max1 <= nums[i])
            max2 = max1, max1 = nums[i];
        else if (max2 < nums[i])
            max2 = nums[i];

    cout << "Max = " << max1 << ", 2nd Max = " << max2 << "\n";


    // ==========================================
    // 4. REVERSE IN PLACE
    // ==========================================
    cout << "\n========== 4. Reverse in Place ==========\n";

    int rev[8] = { 1, 2, 3, 4, 5, 6, 7, 8 };

    for (int i = 0; i < 8 / 2; ++i) {
        int last = 8 - i - 1;
        int temp = rev[i];
        rev[i] = rev[last];
        rev[last] = temp;
    }

    cout << "Reversed: ";
    for (int i = 0; i < 8; ++i)
        cout << rev[i] << " ";
    cout << "\n";


    // ==========================================
    // 5. MOST FREQUENT NUMBER
    // ==========================================
    cout << "\n========== 5. Most Frequent ==========\n";

    int freq_n = 7;
    int freq_arr[200] = { 1, 2, 1, 3, 1, 5, 5 };
    int frequency[151] = { 0 };

    for (int i = 0; i < freq_n; ++i)
        frequency[freq_arr[i]]++;

    int max_pos = -1;
    for (int i = 0; i < 151; ++i)
        if (max_pos == -1 || frequency[max_pos] < frequency[i])
            max_pos = i;

    cout << max_pos << " repeated " << frequency[max_pos] << " times\n";


    // ==========================================
    // 6. CHAR ARRAYS — ASCII
    // ==========================================
    cout << "\n========== 6. Char Arrays ==========\n";

    char ch1 = 'A';
    int ch_value = ch1;
    cout << "ASCII of A = " << ch_value << "\n";
    cout << "ASCII of a = " << (int)'a' << "\n";
    cout << "ASCII of 0 = " << (int)'0' << "\n";
    cout << "'A' < 'a' = " << ('A' < 'a') << "\n";

    // Convert case
    char ch2 = 'D';
    if ('A' <= ch2 && ch2 <= 'Z')
        ch2 = ch2 - 'A' + 'a';
    cout << "Converted: " << ch2 << "\n";


    // ==========================================
    // 7. CHAR ARRAY vs STRING
    // ==========================================
    cout << "\n========== 7. Char Array vs String ==========\n";

    char name1[5] = { 'H', 'a', 'n', 'i', '\0' };
    char name2[5] = "Hani";
    string name3 = "Hani";

    cout << "name1 = " << name1 << "\n";
    cout << "name2 = " << name2 << "\n";
    cout << "name3 = " << name3 << "\n";

    string str_name = "Hany";
    cout << "Size of Hany = " << str_name.size() << "\n";
    for (int i = 0; i < str_name.size(); ++i)
        cout << str_name[i];
    cout << "\n";


    // ==========================================
    // 8. READING STRINGS
    // ==========================================
    cout << "\n========== 8. Reading Strings ==========\n";

    string full_name;
    cout << "Enter full name: ";
    cin.ignore();
    getline(cin, full_name);
    cout << "Full name: " << full_name << "\n";

    // Array of strings
    string names[3] = { "Mostafa Saad", "Never Ever", "Hello world" };
    for (int i = 0; i < 3; ++i)
        cout << names[i] << "\n";


    // ==========================================
    // 9. LETTERS FREQUENCY
    // ==========================================
    cout << "\n========== 9. Letters Frequency ==========\n";

    string letters = "bAAAaaazz";
    int letter_freq[150] = { 0 };

    for (int i = 0; i < letters.size(); ++i)
        letter_freq[letters[i]]++;

    for (int i = 'a'; i <= 'z'; ++i)
        if (letter_freq[i])
            cout << (char)i << " " << letter_freq[i] << "\n";


    // ==========================================
    // 10. SPECIAL STRING MAPPING
    // ==========================================
    cout << "\n========== 10. Special Mapping ==========\n";

    string from = "abcdefghijklmnopqrstuvwxyz0123456789";
    string to = "YZIMNESTODUAPWXHQFBRJKCGVLI@#%^&*()";

    char letter_map[150] = { 0 };
    for (int i = 0; i < from.size(); ++i)
        letter_map[from[i]] = to[i];

    string input = "acMNmn39";
    for (int i = 0; i < input.size(); ++i) {
        if ('A' <= input[i] && input[i] <= 'Z')
            continue;
        input[i] = letter_map[input[i]];
    }
    cout << "Mapped: " << input << "\n";


    // ==========================================
    // 11. CONC STRINGS
    // ==========================================
    cout << "\n========== 11. Conc Strings ==========\n";

    string s = "abc", t = "defghi";
    int i = 0, j = 0;
    cout << "Result: ";
    while (i < s.size() || j < t.size()) {
        if (i < s.size()) cout << s[i++];
        if (j < t.size()) cout << t[j++];
    }
    cout << "\n";

    return 0;
}



