// ============================================
// Day 5: While + For Loops
// ============================================

#include <iostream>
using namespace std;

int main()
{
    // ==========================================
    // 1. WHILE LOOP
    // ==========================================
    cout << "========== 1. While Loop ==========\n";

    int x = 1;
    int sum = 0;
    while (x < 6)
    {
        sum += x;
        ++x;
    }
    cout << "Sum from 1 to 5 = " << sum << "\n";   // 15

    // Countdown
    int y = 5;
    int sum2 = 0;
    while (y >= 0)
    {
        sum2 += y;
        y--;
    }
    cout << "Sum from 5 to 0 = " << sum2 << "\n";  // 15


    // ==========================================
    // 2. BREAK AND CONTINUE
    // ==========================================
    cout << "\n========== 2. Break and Continue ==========\n";

    // Break example
    int a, b;
    cout << "Enter pairs (second = 0 to stop):\n";
    while (true)
    {
        cin >> a >> b;
        if (b == 0)
        {
            cout << "Y is zero!!\n";
            break;
        }
        cout << a / b << "\n";
    }
    cout << "Bye\n";


    // ==========================================
    // 3. WHILE PRACTICE: DIVISIBLE BY 3
    // ==========================================
    cout << "\n========== 3. Divisible by 3 ==========\n";

    int end;
    cout << "Enter end: ";
    cin >> end;

    int start = 1;
    cout << "Numbers divisible by 3 from 1 to " << end << ": ";
    while (start <= end)
    {
        if (start % 3 == 0)
            cout << start << " ";
        start += 1;
    }
    cout << "\n";


    // ==========================================
    // 4. WHILE PRACTICE: POWER
    // ==========================================
    cout << "\n========== 4. Power (X^Y) ==========\n";

    int num, pow;
    cout << "Enter num and power: ";
    cin >> num >> pow;

    int result = 1;
    while (pow >= 1)
    {
        result *= num;
        pow--;
    }
    cout << "Result = " << result << "\n";


    // ==========================================
    // 5. WHILE PRACTICE: COUNT DIGITS
    // ==========================================
    cout << "\n========== 5. Count Digits ==========\n";

    int n;
    cout << "Enter number: ";
    cin >> n;

    int original = n;
    int digits = 0;

    if (n == 0)
        digits = 1;
    else
    {
        if (n < 0)
            n = -n;

        while (n > 0)
        {
            digits += 1;
            n = n / 10;
        }
    }
    cout << "# of digits of " << original << " is " << digits << "\n";


    // ==========================================
    // 6. FOR LOOP
    // ==========================================
    cout << "\n========== 6. For Loop ==========\n";

    int sum3 = 0;
    for (int i = 1; i < 6; ++i)
        sum3 += i;
    cout << "Sum from 1 to 5 = " << sum3 << "\n";   // 15

    // T test cases
    int T;
    cout << "Enter T: ";
    cin >> T;

    for (int t = 0; t < T; ++t)
    {
        int n2, sum4 = 0;
        cout << "Enter N: ";
        cin >> n2;

        for (int s = 1; s <= n2; ++s)
            sum4 += s;

        cout << "Sum from 1 to " << n2 << " = " << sum4 << "\n";
    }


    // ==========================================
    // 7. FOR LOOP: INFINITE
    // ==========================================
    cout << "\n========== 7. Infinite For ==========\n";

    int limit = 5;
    int sum5 = 0;
    int counter = 1;

    for (;;)
    {
        if (!(counter <= limit))
            break;
        sum5 += counter;
        ++counter;
    }
    cout << "Sum = " << sum5 << "\n";   // 15


    // ==========================================
    // 8. FIBONACCI
    // ==========================================
    cout << "\n========== 8. Fibonacci ==========\n";

    int nFib = 10;
    int a1 = 0, b1 = 1;
    cout << a1 << " " << b1 << " ";

    for (int cnt = 2; cnt < nFib; ++cnt)
    {
        int c = a1 + b1;
        a1 = b1;
        b1 = c;
        cout << c << " ";
    }
    cout << "\n";


    // ==========================================
    // 9. NESTED LOOPS: PAIR OF NUMBERS
    // ==========================================
    cout << "\n========== 9. Pair of Numbers ==========\n";

    int nP, mP, target;
    cout << "Enter n, m, sum: ";
    cin >> nP >> mP >> target;

    int cntP = 0;
    for (int i = 1; i <= nP; ++i)
    {
        int j = target - i;
        if (1 <= j && j <= mP)
            cntP++;
    }
    cout << "Pairs: " << cntP << "\n";


    // ==========================================
    // 10. NESTED LOOPS: TRIPLES
    // ==========================================
    cout << "\n========== 10. Triples ==========\n";

    int nT, mT, wT;
    cout << "Enter n, m, w: ";
    cin >> nT >> mT >> wT;

    int cntT = 0;
    for (int i = 1; i <= nT; ++i)
        for (int j = i; j <= mT; ++j)
        {
            int k = i + j;
            if (1 <= k && k <= wT)
                cntT += wT - k + 1;
        }
    cout << "Triples: " << cntT << "\n";


    // ==========================================
    // 11. COMMON ERRORS (Demonstration)
    // ==========================================
    cout << "\n========== 11. Common Errors ==========\n";

    // Correct
    for (int i = 0; i < 3; ++i)
        cout << i << " ";
    cout << "\n";

    // Wrong: semicolon after for
    // for (int i = 0; i < 3; ++i);
    //     cout << "Hello\n";

    // Wrong: i++ inside body
    // for (int i = 0; i < 3; ++i)
    //     cout << i++ << "\n";

    return 0;
}
